;; Utility functions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defun f-read-text-safe (path fallback)
  (require 'f)
  (if (f-exists-p path)
      (f-read-text path)
    fallback))

(defun fun-call-infrequently (fun dur)
  (let* ((name (prin1-to-string fun))
	 (path (concat "~/.cache/emacs/fun-cookie-" name))
	 (expiry (string-to-number (f-read-text-safe path "0")))
	 (now (time-convert nil 'integer)))
    (if (> now expiry)
      (progn
        (funcall fun)
        (f-write-text (number-to-string (+ now dur)) 'utf-8 path))
      (message "Skipping call to %s" name))))

