;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Improved fill-paragraph
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defun toggle-filling ()
  (interactive)
  (let* ((reg-p (use-region-p))
	       (lo (if reg-p (region-beginning)
	             (save-excursion (backward-paragraph) (point))))
	       (hi (if reg-p (region-end)
	             (save-excursion (forward-paragraph) (point))))
	       (old (buffer-substring-no-properties lo hi)))
    (if (use-region-p)
	      (fill-region lo hi)
      (fill-paragraph))
    (let* ((new (buffer-substring-no-properties lo hi))
	         (fill-column 9999))
      (when (string= new old)
	      (if reg-p
	          (fill-region lo hi)
	        (fill-paragraph))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Improved navigation
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defun smarter-move-beginning ()
  (interactive)
  (let* ((at (point))
         (indent (save-excursion
                  (back-to-indentation)
                  (point))))
    (cond
     ((bolp)
      (if (bobp)
          (progn
            (beep)
            (message "Beginning of buffer"))
        (forward-line -1)
        (end-of-line)))
     ((<= at indent)
      (move-to-column 0))
     (t (back-to-indentation)))))


(defun smarter-move-end ()
  (interactive)
  (let* ((at (point))
         (indent (save-excursion
                  (back-to-indentation)
                  (point))))
    (cond
     ((eolp)
      (if (eobp)
          (progn
            (beep)
            (message "End of buffer"))
        (forward-line 1)
        (beginning-of-line)))
     ((< at indent)
      (back-to-indentation))
     (t (end-of-line)))))


(defun smarter-vl-move-end ()
  (interactive)
  (let ((eol (save-excursion
	       (end-of-visual-line 1)
	       (point))))
    (if (< (point) eol)
        (goto-char eol)
      (goto-char (+ eol 1)))))

(defun smarter-vl-move-beginning ()
  (interactive)
  (let ((bol (save-excursion
	       (beginning-of-visual-line 1)
	       (point))))
    (if (> (point) bol)
	(goto-char bol)
      (goto-char (- bol 1)))))

(define-key visual-line-mode-map (kbd "C-a") #'smarter-vl-move-beginning)
(define-key visual-line-mode-map (kbd "C-e") #'smarter-vl-move-end)

